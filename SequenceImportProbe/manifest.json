{
  "name": "SequenceImportProbe",
  "displayName": "シーケンス生成実験",
  "description": "PlantUMLから新しいシーケンス図を生成する実験用拡張。",
  "version": "0.8.0",
  "publisher": "ksk01",
  "main": "main.cs",
  "lifecycle": "project",
  "extensionPoints": {
    "ribbon": {
      "tabs": [
        {
          "id": "SequenceImportProbe.Tab",
          "label": "シーケンス生成実験",
          "groups": [
            {
              "id": "SequenceImportProbe.Run",
              "label": "生成・更新の検証",
              "controls": [
                {
                  "id": "SequenceImportProbe.SyncPreviewButton",
                  "type": "Button",
                  "label": "図全体の差分を検証",
                  "command": "SequenceImportProbe.SyncPreview"
                },
                {
                  "id": "SequenceImportProbe.MapButton",
                  "type": "Button",
                  "label": "差分対応表を作成",
                  "command": "SequenceImportProbe.Map"
                },
                {
                  "id": "SequenceImportProbe.MappedUpdateButton",
                  "type": "Button",
                  "label": "メッセージを差分更新",
                  "command": "SequenceImportProbe.MappedUpdate"
                },
                {
                  "id": "SequenceImportProbe.ImportButton",
                  "type": "Button",
                  "label": "PlantUMLを取り込む",
                  "command": "SequenceImportProbe.Import"
                },
                {
                  "id": "SequenceImportProbe.ReplaceButton",
                  "type": "Button",
                  "label": "全体置換（旧実験）",
                  "command": "SequenceImportProbe.Replace"
                },
                {
                  "id": "SequenceImportProbe.CreateButton",
                  "type": "Button",
                  "label": "最小図を生成",
                  "command": "SequenceImportProbe.Create"
                },
                {
                  "id": "SequenceImportProbe.DeltaProbeButton",
                  "type": "Button",
                  "label": "差分更新APIを検証",
                  "command": "SequenceImportProbe.DeltaProbe"
                },
                {
                  "id": "SequenceImportProbe.UpdateProbeButton",
                  "type": "Button",
                  "label": "更新APIを検証",
                  "command": "SequenceImportProbe.UpdateProbe"
                },
                {
                  "id": "SequenceImportProbe.ResultButton",
                  "type": "Button",
                  "label": "結果表示",
                  "command": "SequenceImportProbe.Result"
                },
                {
                  "id": "SequenceImportProbe.DetailsButton",
                  "type": "Button",
                  "label": "診断表示",
                  "command": "SequenceImportProbe.Details"
                }
              ]
            }
          ]
        }
      ]
    },
    "commands": [
      {
        "id": "SequenceImportProbe.Create",
        "execFunc": "CreateMinimalSequence"
      },
      {
        "id": "SequenceImportProbe.Result",
        "execFunc": "ShowSequenceResult"
      },
      {
        "id": "SequenceImportProbe.Details",
        "execFunc": "ShowSequenceDetails"
      },
      {
        "id": "SequenceImportProbe.Import",
        "execFunc": "ImportPlantUml"
      },
      {
        "id": "SequenceImportProbe.UpdateProbe",
        "execFunc": "ProbeSequenceUpdate"
      },
      {
        "id": "SequenceImportProbe.Replace",
        "execFunc": "ReplaceSequence"
      },
      {
        "id": "SequenceImportProbe.DeltaProbe",
        "execFunc": "ProbeSequenceDelta"
      },
      {
        "id": "SequenceImportProbe.Map",
        "execFunc": "CreateSequenceMap"
      },
      {
        "id": "SequenceImportProbe.MappedUpdate",
        "execFunc": "UpdateMappedSequence"
      },
      {
        "id": "SequenceImportProbe.SyncPreview",
        "execFunc": "PreviewSequenceSync"
      }
    ]
  }
}
