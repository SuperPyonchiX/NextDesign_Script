{
  "name": "SequenceImportProbe",
  "displayName": "シーケンス生成実験",
  "description": "PlantUMLから新しいシーケンス図を生成する実験用拡張。",
  "version": "0.11.26",
  "publisher": "ksk01",
  "main": "main.cs",
  "lifecycle": "project",
  "extensionPoints": {
    "ribbon": {
      "tabs": [
        {
          "id": "SequenceImportProbe.Tab",
          "label": "シーケンス生成実験",
          "groups": [
            {
              "id": "SequenceImportProbe.Diagnostics",
              "label": "結果・診断",
              "controls": [
                {
                  "id": "SequenceImportProbe.DetailsButton",
                  "type": "Button",
                  "label": "診断表示",
                  "command": "SequenceImportProbe.Details"
                },
                {
                  "id": "SequenceImportProbe.SnapshotProbeButton",
                  "type": "Button",
                  "label": "保存なし反映の調査",
                  "command": "SequenceImportProbe.SnapshotProbe"
                },
                {
                  "id": "SequenceImportProbe.OmissionProbeButton",
                  "type": "Button",
                  "label": "書き戻し調査（コピーで）",
                  "command": "SequenceImportProbe.OmissionProbe"
                }
              ]
            },
            {
              "id": "SequenceImportProbe.Input",
              "label": "取込・比較",
              "controls": [
                {
                  "id": "SequenceImportProbe.ImportButton",
                  "type": "Button",
                  "label": "PlantUML取込",
                  "command": "SequenceImportProbe.Import"
                },
                {
                  "id": "SequenceImportProbe.SyncPreviewButton",
                  "type": "Button",
                  "label": "差分を検証",
                  "command": "SequenceImportProbe.SyncPreview"
                },
                {
                  "id": "SequenceImportProbe.SweepButton",
                  "type": "Button",
                  "label": "全図チェック",
                  "command": "SequenceImportProbe.Sweep"
                }
              ]
            },
            {
              "id": "SequenceImportProbe.Run",
              "label": "反映",
              "controls": [
                {
                  "id": "SequenceImportProbe.CommitReceiverButton",
                  "type": "Button",
                  "label": "PlantUMLを反映",
                  "command": "SequenceImportProbe.CommitReceiver"
                },
                {
                  "id": "SequenceImportProbe.BatchButton",
                  "type": "Button",
                  "label": "シナリオ一括検証",
                  "command": "SequenceImportProbe.Batch"
                },
                {
                  "id": "SequenceImportProbe.BatchSdkButton",
                  "type": "Button",
                  "label": "一括検証（保存なし写し）",
                  "command": "SequenceImportProbe.BatchSdk"
                }
              ]
            }
          ]
        }
      ]
    },
    "commands": [
      {
        "id": "SequenceImportProbe.Details",
        "execFunc": "ShowSequenceDetails"
      },
      {
        "id": "SequenceImportProbe.Import",
        "execFunc": "ImportPlantUml"
      },
      {
        "id": "SequenceImportProbe.SyncPreview",
        "execFunc": "PreviewSequenceSync"
      },
      {
        "id": "SequenceImportProbe.CommitReceiver",
        "execFunc": "CommitReceiverStructure"
      },
      {
        "id": "SequenceImportProbe.Batch",
        "execFunc": "RunScenarioBatch"
      },
      {
        "id": "SequenceImportProbe.Sweep",
        "execFunc": "CheckAllSequences"
      },
      {
        "id": "SequenceImportProbe.SnapshotProbe",
        "execFunc": "ProbeUnsavedSnapshot"
      },
      {
        "id": "SequenceImportProbe.OmissionProbe",
        "execFunc": "ProbeOmittedValues"
      },
      {
        "id": "SequenceImportProbe.BatchSdk",
        "execFunc": "RunScenarioBatchFromSdk"
      }
    ]
  }
}
