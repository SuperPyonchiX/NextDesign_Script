@startuml
participant A
participant B
activate A
alt wrapped
note over A,B : inside
A -> B : first()
activate B
B --> A : firstDone()
deactivate B
end
A -> B : second()
activate B
B --> A : secondDone()
deactivate B
A -> B : third()
activate B
B --> A : thirdDone()
deactivate B
deactivate A
@enduml
