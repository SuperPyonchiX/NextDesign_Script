@startuml
participant A
participant B
activate A
A -> B : first()
activate B
B --> A : firstDone()
deactivate B
A -> B : second()
activate B
B --> A : secondDone()
deactivate B
A -> B : third()
activate B
B --> A : thirdDone()
deactivate B
alt noted
note over A,B : inside
A -> B : inner()
activate B
B --> A : innerDone()
deactivate B
end
deactivate A
@enduml
