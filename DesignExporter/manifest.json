{
  "name": "DesignExporter",
  "displayName": "設計情報出力",
  "description": "設計情報を生成 AI へのインプット用に出力します。モデル配下を Markdown 1 ファイルに、シーケンス図・クラス図を PlantUML 形式に変換できます。",
  "version": "3.0.0",
  "publisher": "ksk01",
  "main": "main.cs",
  "lifecycle": "project",

  "extensionPoints": {
    "ribbon": {
      "tabs": [
        {
          "id": "DesignExporter.Tab",
          "label": "設計情報出力",
          "orderAfter": "System.View",
          "groups": [
            {
              "id": "DesignExporter.ExportGroup",
              "label": "出力",
              "controls": [
                {
                  "id": "DesignExporter.ExportCurrentButton",
                  "type": "Button",
                  "label": "表示中の図を出力",
                  "description": "エディタで表示中のシーケンス図またはクラス図を PlantUML 形式で出力します。",
                  "imageSmall": "resources/export16.png",
                  "imageLarge": "resources/export32.png",
                  "command": "DesignExporter.ExportCurrent"
                },
                {
                  "id": "DesignExporter.ExportAllButton",
                  "type": "Button",
                  "label": "選択モデル配下を一括出力",
                  "description": "ナビゲータで選択中のモデル配下のすべてのシーケンス図とクラス図を PlantUML 形式で出力します。",
                  "imageSmall": "resources/exportall16.png",
                  "imageLarge": "resources/exportall32.png",
                  "command": "DesignExporter.ExportAll"
                },
                {
                  "id": "DesignExporter.ExportMarkdownButton",
                  "type": "Button",
                  "label": "設計情報を Markdown 出力",
                  "description": "ナビゲータで選択中のモデル配下の設計情報（フィールドと図）を 1 つの Markdown ファイルに出力します。生成 AI へのインプットに利用できます。",
                  "imageSmall": "resources/markdown16.png",
                  "imageLarge": "resources/markdown32.png",
                  "command": "DesignExporter.ExportMarkdown"
                }
              ]
            },
            {
              "id": "DesignExporter.DiagnosticsGroup",
              "label": "診断",
              "controls": [
                {
                  "id": "DesignExporter.ProbeButton",
                  "type": "Button",
                  "label": "メタモデル調査",
                  "description": "アクティブなシーケンス図のメタモデル構造を出力ウィンドウにダンプします。",
                  "imageSmall": "resources/probe16.png",
                  "imageLarge": "resources/probe32.png",
                  "command": "DesignExporter.Probe"
                },
                {
                  "id": "DesignExporter.ProbeClassButton",
                  "type": "Button",
                  "label": "クラス図調査",
                  "description": "アクティブなクラス図のノード・コネクタ・参照フィールドを出力ウィンドウにダンプします。",
                  "imageSmall": "resources/probeclass16.png",
                  "imageLarge": "resources/probeclass32.png",
                  "command": "DesignExporter.ProbeClass"
                }
              ]
            }
          ]
        }
      ]
    },

    "commandGroups": [
      { "name": "designexporter", "title": "設計情報出力" }
    ],

    "commands": [
      {
        "id": "DesignExporter.ExportCurrent",
        "title": "表示中の図を出力",
        "group": "designexporter",
        "execFunc": "ExportCurrentDiagram",
        "canExecWhen": { "uiState": "ProjectOpened" }
      },
      {
        "id": "DesignExporter.ExportAll",
        "title": "選択モデル配下を一括出力",
        "group": "designexporter",
        "execFunc": "ExportAllDiagrams",
        "canExecWhen": { "uiState": "ProjectOpened" }
      },
      {
        "id": "DesignExporter.ExportMarkdown",
        "title": "設計情報を Markdown 出力",
        "group": "designexporter",
        "execFunc": "ExportMarkdown",
        "canExecWhen": { "uiState": "ProjectOpened" }
      },
      {
        "id": "DesignExporter.Probe",
        "title": "メタモデル調査",
        "group": "designexporter",
        "execFunc": "ProbeMetamodel",
        "canExecWhen": { "uiState": "ProjectOpened" }
      },
      {
        "id": "DesignExporter.ProbeClass",
        "title": "クラス図調査",
        "group": "designexporter",
        "execFunc": "ProbeClassDiagram",
        "canExecWhen": { "uiState": "ProjectOpened" }
      }
    ]
  }
}
