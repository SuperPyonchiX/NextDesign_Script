<Project>

  <!--
    リポジトリ内の Next Design エクステンション（DLL 方式）に共通の設定。
    各 csproj より先に自動で読み込まれる。値は Next Design V3.x で確認したもの。
  -->
  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 新しい SDK で net6.0 をビルドするときのサポート終了警告を止める -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- ソースは各 csproj に記載順で列挙する。tests/ の .cs や共有元の別ファイルを勝手に取り込まない -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    NextDesign.Core / NextDesign.Desktop の参照元を切り替える。
    - 既定: NuGet の公開版（V3 系の最新 3.1.3）を参照する
    - -p:NextDesignDir="<インストール先>" を渡したとき: インストール先の DLL を直接参照する
    どちらも実行時は Next Design 本体の DLL を使うので、出力には含めない。
  -->
  <ItemGroup Condition="'$(NextDesignDir)' != ''">
    <!-- NuGet の NextDesign.Desktop が宣言している WPF 参照を補う。無いと WindowsBase の版競合警告が出る -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <Reference Include="NextDesign.Core">
      <HintPath>$(NextDesignDir)\NextDesign.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NextDesign.Desktop">
      <HintPath>$(NextDesignDir)\NextDesign.Desktop.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(NextDesignDir)' == ''">
    <PackageReference Include="NextDesign.Core" Version="3.1.3.30714" ExcludeAssets="runtime" />
    <PackageReference Include="NextDesign.Desktop" Version="3.1.3.30714" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- 配置に必要なファイルを出力へコピーする -->
  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('manifest.json')" />
    <None Include="resources\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
