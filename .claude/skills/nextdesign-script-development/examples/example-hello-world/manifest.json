{
  "name": "HelloWorld",
  "version": "1.0.0",
  "description": "Hello Worldダイアログを表示するサンプルエクステンション",
  "author": "サンプル",
  "main": "main.cs",
  "lifecycle": "application",
  "extensionPoints": {
    "ribbon": {
      "tabs": [
        {
          "id": "HelloWorld.Tab",
          "label": "サンプル",
          "groups": [
            {
              "id": "HelloWorld.Group",
              "label": "あいさつ",
              "controls": [
                {
                  "id": "HelloWorld.Button.SayHello",
                  "type": "Button",
                  "label": "Hello",
                  "tooltip": "Hello Worldダイアログを表示します",
                  "command": "HelloWorld.Command.SayHello"
                }
              ]
            }
          ]
        }
      ]
    },
    "commands": [
      {
        "id": "HelloWorld.Command.SayHello",
        "name": "Hello World表示",
        "execFunc": "SayHello"
      }
    ]
  }
}
