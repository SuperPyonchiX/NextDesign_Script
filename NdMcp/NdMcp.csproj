    <Using Include="System.Threading" />
    <Using Include="NextDesign.Core" />
    <Using Include="NextDesign.Desktop" />
    <Using Include="NextDesign.Extension" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src\extension.cs" />
