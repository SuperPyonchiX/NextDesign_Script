{
  "name": "PlantUmlTool",
  "displayName": "PlantUML 連携",
  "description": "シーケンス図・クラス図・状態遷移図を PlantUML 形式で出力し、編集した PlantUML をシーケンス図・クラス図へ反映します。PlantUML から新しいシーケンス図・クラス図も作れます。",
  "version": "3.1.1",
  "publisher": "ksk01",
  "main": "PlantUmlTool.dll",
  "lifecycle": "project",
  "extensionPoints": {
    "ribbon": {
      "tabs": [
        {
          "id": "PlantUmlTool.Tab",
          "label": "PlantUML",
          "orderAfter": "System.View",
          "groups": [
            {
              "id": "PlantUmlTool.ExportGroup",
              "label": "出力",
              "controls": [
                {
                  "id": "PlantUmlTool.ExportCurrentButton",
                  "type": "Button",
                  "label": "表示中の図を出力",
                  "description": "エディタで表示中のシーケンス図・クラス図・状態遷移図を PlantUML 形式で出力します。",
                  "imageSmall": "resources/export16.png",
                  "imageLarge": "resources/export32.png",
                  "command": "PlantUmlTool.ExportCurrent"
                },
                {
                  "id": "PlantUmlTool.ExportAllButton",
                  "type": "Button",
                  "label": "選択モデル配下を一括出力",
                  "description": "ナビゲータで選択中のモデル配下のすべてのシーケンス図・クラス図・状態遷移図を PlantUML 形式で出力します。",
                  "imageSmall": "resources/exportall16.png",
                  "imageLarge": "resources/exportall32.png",
                  "command": "PlantUmlTool.ExportAll"
                }
              ]
            },
            {
              "id": "PlantUmlTool.SequenceSyncGroup",
              "label": "反映（シーケンス図）",
              "controls": [
                {
                  "id": "PlantUmlTool.ApplySequenceSyncButton",
                  "type": "Button",
                  "label": "PlantUMLを反映",
                  "description": "PlantUML ファイルの内容を表示中のシーケンス図に反映します。照合が一致したときだけ確定し、一致しなければ元に戻します。未保存でも反映します（保存はしません）。",
                  "imageSmall": "resources/import16.png",
                  "imageLarge": "resources/import32.png",
                  "command": "PlantUmlTool.ApplySequenceSync"
                },
                {
                  "id": "PlantUmlTool.CreateSequenceDiagramButton",
                  "type": "Button",
                  "label": "PlantUMLから新規作成",
                  "description": "PlantUML ファイルの内容で新しいシーケンス図を作ります。開いているシーケンス図と同じ所有先、または開いている・選んでいるモデルの下に作ります（保存はしません）。",
                  "imageSmall": "resources/importall16.png",
                  "imageLarge": "resources/importall32.png",
                  "command": "PlantUmlTool.CreateSequenceDiagram"
                }
              ]
            },
            {
              "id": "PlantUmlTool.SyncGroup",
              "label": "反映（クラス図）",
              "controls": [
                {
                  "id": "PlantUmlTool.ApplyClassSyncButton",
                  "type": "Button",
                  "label": "PlantUMLを反映",
                  "description": "PlantUML ファイルの内容を表示中のクラス図とモデルに反映します（確定。Undo できます）。",
                  "imageSmall": "resources/import16.png",
                  "imageLarge": "resources/import32.png",
                  "command": "PlantUmlTool.ApplyClassSync"
                },
                {
                  "id": "PlantUmlTool.CreateClassDiagramButton",
                  "type": "Button",
                  "label": "PlantUMLから新規作成",
                  "description": "PlantUML ファイルの内容で、開いている・選んでいるクラス図グループの下に新しいクラス図を作ります。クラスの置き場は package \"モデル名\" { } で指定します（途中で保存します）。",
                  "imageSmall": "resources/newclass16.png",
                  "imageLarge": "resources/newclass32.png",
                  "command": "PlantUmlTool.CreateClassDiagram"
                }
              ]
            }
          ]
        }
      ]
    },
    "commandGroups": [
      {
        "name": "plantuml",
        "title": "PlantUML 連携"
      }
    ],
    "commands": [
      {
        "id": "PlantUmlTool.ExportCurrent",
        "title": "表示中の図を出力",
        "group": "plantuml",
        "execFunc": "ExportCurrentDiagram",
        "canExecWhen": {
          "uiState": "ProjectOpened"
        }
      },
      {
        "id": "PlantUmlTool.ExportAll",
        "title": "選択モデル配下を一括出力",
        "group": "plantuml",
        "execFunc": "ExportAllDiagrams",
        "canExecWhen": {
          "uiState": "ProjectOpened"
        }
      },
      {
        "id": "PlantUmlTool.ApplySequenceSync",
        "title": "PlantUMLを反映（シーケンス図）",
        "group": "plantuml",
        "execFunc": "ApplySequenceSync",
        "canExecWhen": {
          "uiState": "ProjectOpened"
        }
      },
      {
        "id": "PlantUmlTool.CreateSequenceDiagram",
        "title": "PlantUMLから新規作成（シーケンス図）",
        "group": "plantuml",
        "execFunc": "CreateSequenceDiagram",
        "canExecWhen": {
          "uiState": "ProjectOpened"
        }
      },
      {
        "id": "PlantUmlTool.ApplyClassSync",
        "title": "PlantUMLを反映",
        "group": "plantuml",
        "execFunc": "ApplyClassSync",
        "canExecWhen": {
          "uiState": "ProjectOpened"
        }
      },
      {
        "id": "PlantUmlTool.CreateClassDiagram",
        "title": "PlantUMLから新規作成",
        "group": "plantuml",
        "execFunc": "CreateClassDiagram",
        "canExecWhen": {
          "uiState": "ProjectOpened"
        }
      }
    ]
  }
}
