{
  "name": "PlantUmlTool",
  "displayName": "PlantUML 連携",
  "description": "シーケンス図・クラス図・状態遷移図を PlantUML 形式で出力し、編集した PlantUML をシーケンス図・クラス図へ反映します。PlantUML から新しいシーケンス図・クラス図も作れます。",
  "version": "3.3.2",
  "publisher": "ksk01",
  "main": "PlantUmlTool.dll",
  "lifecycle": "project",
  "extensionPoints": {
    "ribbon": {
      "tabs": [
        {
          "id": "PlantUmlTool.Tab",
          "label": "PlantUML",
          "orderAfter": "System.View",
          "groups": [
            {
              "id": "PlantUmlTool.ExportGroup",
              "label": "出力",
              "controls": [
                {
                  "id": "PlantUmlTool.ExportCurrentButton",
                  "type": "Button",
                  "label": "表示中の図を出力",
                  "description": "エディタで表示中のシーケンス図・クラス図・状態遷移図を PlantUML 形式で出力します。",
                  "imageSmall": "resources/export16.png",
                  "imageLarge": "resources/export32.png",
                  "command": "PlantUmlTool.ExportCurrent"
                },
                {
                  "id": "PlantUmlTool.ExportAllButton",
                  "type": "Button",
                  "label": "選択モデル配下を一括出力",
                  "description": "ナビゲータで選択中のモデル配下のすべてのシーケンス図・クラス図・状態遷移図を PlantUML 形式で出力します。",
                  "imageSmall": "resources/exportall16.png",
                  "imageLarge": "resources/exportall32.png",
                  "command": "PlantUmlTool.ExportAll"
                }
              ]
            },
            {
              "id": "PlantUmlTool.SyncGroup",
              "label": "反映",
              "controls": [
                {
                  "id": "PlantUmlTool.ApplyButton",
                  "type": "Button",
                  "label": "PlantUMLで更新",
                  "description": "PlantUML ファイルの内容を、開いているシーケンス図またはクラス図に反映します。照合が一致したときだけ確定し、一致しなければ元に戻します。",
                  "imageSmall": "resources/import16.png",
                  "imageLarge": "resources/import32.png",
                  "command": "PlantUmlTool.Apply"
                },
                {
                  "id": "PlantUmlTool.CreateButton",
                  "type": "Button",
                  "label": "PlantUMLから新規作成",
                  "description": "PlantUML ファイルの内容で新しい図を作ります。シーケンス図・クラス図を開いていればその隣に同じ種類の図を、モデルを開いている・選んでいればそのモデルに置ける種類の図を作ります。",
                  "imageSmall": "resources/newclass16.png",
                  "imageLarge": "resources/newclass32.png",
                  "command": "PlantUmlTool.Create"
                }
              ]
            }
          ]
        }
      ]
    },
    "commandGroups": [
      {
        "name": "plantuml",
        "title": "PlantUML 連携"
      }
    ],
    "commands": [
      {
        "id": "PlantUmlTool.ExportCurrent",
        "title": "表示中の図を出力",
        "group": "plantuml",
        "execFunc": "ExportCurrentDiagram",
        "canExecWhen": {
          "uiState": "ProjectOpened"
        }
      },
      {
        "id": "PlantUmlTool.ExportAll",
        "title": "選択モデル配下を一括出力",
        "group": "plantuml",
        "execFunc": "ExportAllDiagrams",
        "canExecWhen": {
          "uiState": "ProjectOpened"
        }
      },
      {
        "id": "PlantUmlTool.Apply",
        "title": "PlantUMLで更新",
        "group": "plantuml",
        "execFunc": "ApplyPlantUml",
        "canExecWhen": {
          "uiState": "ProjectOpened"
        }
      },
      {
        "id": "PlantUmlTool.Create",
        "title": "PlantUMLから新規作成",
        "group": "plantuml",
        "execFunc": "CreateFromPlantUml",
        "canExecWhen": {
          "uiState": "ProjectOpened"
        }
      }
    ]
  }
}
