{
  "name": "ClassImportProbe",
  "displayName": "クラス図同期実験",
  "description": "PlantUMLを正本にして既存クラス図を差分更新する拡張。",
  "version": "0.7.1",
  "publisher": "ksk01",
  "main": "main.cs",
  "lifecycle": "project",
  "extensionPoints": {
    "ribbon": {
      "tabs": [
        {
          "id": "ClassImportProbe.Tab",
          "label": "クラス図同期実験",
          "groups": [
            {
              "id": "ClassImportProbe.Diagnostics",
              "label": "結果・診断",
              "controls": [
                {
                  "id": "ClassImportProbe.DetailsButton",
                  "type": "Button",
                  "label": "診断表示",
                  "command": "ClassImportProbe.Details"
                },
                {
                  "id": "ClassImportProbe.ResultButton",
                  "type": "Button",
                  "label": "結果表示",
                  "command": "ClassImportProbe.Result"
                }
              ]
            },
            {
              "id": "ClassImportProbe.Probe",
              "label": "調査",
              "controls": [
                {
                  "id": "ClassImportProbe.ProbeButton",
                  "type": "Button",
                  "label": "クラス図調査",
                  "command": "ClassImportProbe.ProbeDiagram"
                }
              ]
            },
            {
              "id": "ClassImportProbe.Compare",
              "label": "比較",
              "controls": [
                {
                  "id": "ClassImportProbe.PreviewButton",
                  "type": "Button",
                  "label": "差分を検証",
                  "command": "ClassImportProbe.SyncPreview"
                }
              ]
            },
            {
              "id": "ClassImportProbe.Apply",
              "label": "反映",
              "controls": [
                {
                  "id": "ClassImportProbe.ApplyButton",
                  "type": "Button",
                  "label": "PlantUMLを反映",
                  "command": "ClassImportProbe.ApplySync"
                }
              ]
            },
            {
              "id": "ClassImportProbe.TextUpdate",
              "label": "更新の検証",
              "controls": [
                {
                  "id": "ClassImportProbe.TrialTextButton",
                  "type": "Button",
                  "label": "更新を試行して戻す",
                  "command": "ClassImportProbe.TrialText"
                },
                {
                  "id": "ClassImportProbe.CommitTextButton",
                  "type": "Button",
                  "label": "更新を確定",
                  "command": "ClassImportProbe.CommitText"
                }
              ]
            }
          ]
        }
      ]
    },
    "commands": [
      {
        "id": "ClassImportProbe.ApplySync",
        "execFunc": "ApplyClassSync"
      },
      {
        "id": "ClassImportProbe.TrialText",
        "execFunc": "TrialClassText"
      },
      {
        "id": "ClassImportProbe.CommitText",
        "execFunc": "CommitClassText"
      },
      {
        "id": "ClassImportProbe.Result",
        "execFunc": "ShowClassResult"
      },
      {
        "id": "ClassImportProbe.Details",
        "execFunc": "ShowClassDetails"
      },
      {
        "id": "ClassImportProbe.ProbeDiagram",
        "execFunc": "ProbeClassDiagram"
      },
      {
        "id": "ClassImportProbe.SyncPreview",
        "execFunc": "PreviewClassSync"
      }
    ]
  }
}
